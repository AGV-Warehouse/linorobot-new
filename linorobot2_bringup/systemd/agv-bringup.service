[Unit]
Description=AGV bringup (micro-ROS agent, lidar, EKF, rosbridge, map viewer)
After=network-online.target
Wants=network-online.target

[Service]
User=hjt-2
ExecStart=/home/hjt-2/linorobot2_ws/src/linorobot-new/linorobot2_bringup/systemd/agv-start.sh bringup
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
